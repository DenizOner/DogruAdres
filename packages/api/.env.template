STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:7000,http://localhost:9000
VENDOR_CORS=http://localhost:7001
AUTH_CORS=http://localhost:7000,http://localhost:7001,http://localhost:9000
REDIS_URL=redis://localhost:6379
# The following defaults are for LOCAL DEVELOPMENT ONLY. In production set two
# distinct strong random values (>= 32 bytes each) and make them available during
# BOTH Medusa build and runtime configuration evaluation. The application rejects
# missing, weak and placeholder values in production.
# Generate one value: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
MERCUR_VENDOR_URL=http://localhost:7001
STOREFRONT_REVALIDATE_URL=http://localhost:3000
STOREFRONT_REVALIDATE_SECRET=supersecret
# Required for invitation-token derivation. Generate a local secret of at least 32 random bytes, for example:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Keep the generated value in your untracked .env file or secret manager; never commit it.
DOGRUADRES_INVITATION_SECRET=
# Project-owned personal ingress: enable only after additive migrations and review.
# Disabling this UI flag never disables the native ingress fence.
DOGRUADRES_IDENTITY_ENABLED=false
DOGRUADRES_PUBLIC_ORIGIN=
# Supply an independent random secret of at least 32 bytes; never commit it.
DOGRUADRES_MFA_ENCRYPTION_KEY=

# Trusted portable ingress; native API must be a distinct loopback HTTP origin.
DOGRUADRES_PRIVATE_API=
DOGRUADRES_FRONTDOOR_HOST=
DOGRUADRES_FRONTDOOR_PORT=
# Direct HTTPS termination: external PEM paths, never private key contents.
DOGRUADRES_TLS_CERT=
DOGRUADRES_TLS_KEY=